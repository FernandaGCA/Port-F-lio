/*   BARRA DE ÍCONES FIXA */
.icon-bar {
  position: fixed;
  bottom: 0;
  left: 0;

  width: 100%;
  height: 80px;

  display: flex;
  justify-content: center;
  align-items: center;

  gap: 20px;
  background-color: rgba(0, 0, 0, 0.40); /* Fundo preto com 40% de opacidade */
  padding: 10px 20px;
  box-sizing: border-box;
  z-index: 9999;
}

/* Cada ícone */
.icon-bar .icon {
  width: 50px;
  height: 50px;

  display: flex;
  justify-content: center;
  align-items: center;

  flex-shrink: 0;
}

/* Imagem */
.icon-bar .icon img {
  width: 50px;
  height: 50px;

  object-fit: contain;

  transition: transform 0.2s ease;
}

/* Efeito ao passar o mouse */
.icon-bar .icon img:hover {
  transform: scale(1.15);
}




