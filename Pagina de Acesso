	<body>
		<div class="container">
		
		<!-- CLIMA -->
		<div class="widget weather-widget">
			<h2>Clima</h2>
		<div class="temp" id="weather-temp">--°C</div>
		<p id="weather-description">Carregando...</p>
		<p id="weather-location">Aguardando permissão</p>
		</div>
<script>

	async function obterClima(latitude, longitude) {
    try {
        const url =
            `https://api.open-meteo.com/v1/forecast` +
            `?latitude=${latitude}` +
            `&longitude=${longitude}` +
            `&current=temperature_2m,weather_code` +
            `&temperature_unit=celsius` +
            `&timezone=auto`;

        const resposta = await fetch(url);

        if (!resposta.ok) {
            throw new Error("Erro ao buscar clima");
        }

        const dados = await resposta.json();

        const temperatura =
            Math.round(dados.current.temperature_2m);

        const codigo =
            dados.current.weather_code;

        let icone = "☀️";
        let descricao = "Ensolarado";


        /* CONDIÇÕES CLIMÁTICAS */

        if (codigo === 0) {

            icone = "☀️";
            descricao = "Ensolarado";

        } else if (codigo === 1 || codigo === 2) {

            icone = "🌤️";
            descricao = "Parcialmente nublado";

        } else if (codigo === 3) {

            icone = "☁️";
            descricao = "Nublado";

        } else if (codigo === 45 || codigo === 48) {

            icone = "🌫️";
            descricao = "Neblina";

        } else if (codigo >= 51 && codigo <= 57) {

            icone = "🌦️";
            descricao = "Garoa";

        } else if (codigo >= 61 && codigo <= 67) {

            icone = "🌧️";
            descricao = "Chuva";

        } else if (codigo >= 80 && codigo <= 82) {

            icone = "🌧️";
            descricao = "Pancadas de chuva";

        } else if (codigo >= 95) {

            icone = "⛈️";
            descricao = "Tempestade";
        }


        /* ATUALIZA O PAINEL */

        document.getElementById("weather-temp")
            .textContent =
            `${icone} ${temperatura}°C`;

        document.getElementById("weather-description")
            .textContent =
            descricao;

        document.getElementById("weather-location")
            .textContent =
            `📍 Localização atual`;

    } catch (erro) {

        console.error(erro);

        document.getElementById("weather-description")
            .textContent =
            "Não foi possível obter o clima";

    }

}

/* SOLICITA A LOCALIZAÇÃO */

	function obterLocalizacao() {

    if (!navigator.geolocation) {

        document.getElementById("weather-description")
            .textContent =
            "Seu navegador não suporta localização.";

        return;
    }


    navigator.geolocation.getCurrentPosition(

        function(position) {

            const latitude =
                position.coords.latitude;

            const longitude =
                position.coords.longitude;


            console.log("Latitude:", latitude);
            console.log("Longitude:", longitude);


            obterClima(
                latitude,
                longitude
            );

        },

        function(erro) {

            console.error(erro);

            document.getElementById("weather-description")
                .textContent =
                "Permissão de localização negada";

            document.getElementById("weather-location")
                .textContent =
                "Ative a localização para ver o clima";

        },

        {
            enableHighAccuracy: true,
            timeout: 10000,
            maximumAge: 300000
        }
    );
}

/* INICIA */

obterLocalizacao();

/*
   Verifica novamente a localização
   a cada 10 minutos
*/
	setInterval(
    obterLocalizacao,
    10 * 60 * 1000
);

</script>

<!-- Painel de Horas -->
	<div class="clock-widget">
		<div class="date" id="date"></div>
		<div class="time" id="clock">00:00:00</div>
	</div>

<script>
	function updateClock() {

    const now = new Date();

    /* HORA */
    const hours = String(now.getHours()).padStart(2, "0");
    const minutes = String(now.getMinutes()).padStart(2, "0");
    const seconds = String(now.getSeconds()).padStart(2, "0");

    document.getElementById("clock").textContent =
        `${hours}:${minutes}:${seconds}`;


    /* DATA - FORMATO AMERICANO */
    const date = now.toLocaleDateString("en-US", {
        weekday: "long",
        month: "long",
        day: "numeric",
        year: "numeric"
    });

    document.getElementById("date").textContent = date;
}

	updateClock();
	setInterval(updateClock, 1000);
</script>
	

